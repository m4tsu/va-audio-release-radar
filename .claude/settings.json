{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/migrations-guard.mjs\"",
            "timeout": 60,
            "statusMessage": "マイグレーションの適用漏れを確認中"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/migrations-guard.mjs\"",
            "timeout": 60,
            "statusMessage": "マイグレーションの適用漏れを確認中"
          }
        ]
      }
    ]
  }
}
