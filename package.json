{
  "name": "voice-actor-audio-release-radar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:migrations": "node --no-warnings scripts/check-migrations.mjs",
    "check:docs": "node --no-warnings scripts/check-docs.mjs",
    "check:layers": "node --no-warnings scripts/check-app-layers.mjs",
    "check": "npm run check:migrations && npm run check:docs && npm run check:layers && npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy --var SITE_URL:https://koetrail.com",
    "radar": "node crawler/cli.ts",
    "radar:crawl": "node crawler/run.ts",
    "radar:daily": "node crawler/daily.ts",
    "radar:anilist": "node crawler/anilist.ts",
    "radar:kana": "node crawler/kana.ts",
    "radar:delist": "node crawler/delist.ts",
    "radar:typecheck": "tsc -p tsconfig.crawler.json --noEmit",
    "radar:test": "vitest run --project node crawler",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:export:local": "node --no-warnings scripts/d1-export-local.mjs",
    "db:restore:local": "node --no-warnings scripts/d1-restore-local.mjs",
    "db:import:remote": "wrangler d1 execute DB --remote --file",
    "db:import:local": "wrangler d1 execute DB --local --file",
    "db:counts": "node --no-warnings scripts/d1-counts.mjs",
    "db:reset:e2e": "node e2e/fixtures/e2e-db.mjs reset",
    "db:migrate:e2e": "node e2e/fixtures/e2e-db.mjs migrate",
    "db:seed:e2e": "node e2e/fixtures/e2e-db.mjs seed",
    "e2e:prepare": "node e2e/fixtures/prepare.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.56",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/vite-plugin": "^1.55.0",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.38",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
